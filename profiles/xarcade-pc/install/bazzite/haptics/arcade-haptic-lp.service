[Unit]
Description=Arcade haptic kit - low-passed haptics for non-VPX pinball games (Pinball Wicked)
After=pipewire.service wireplumber.service arcade-haptic.service
Requires=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c %h/Emulation/tools/arcade-haptic-lp.conf
ExecStartPost=/bin/bash -c 'sleep 2; exec %h/Emulation/tools/scripts/haptic-router.sh &'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
