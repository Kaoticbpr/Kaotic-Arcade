[Unit]
Description=Arcade haptic kit - Pinball Playfield output (TV + pedestal haptics)
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c %h/Emulation/tools/arcade-haptic.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
