# Copy to machine.env and fill in. machine.env is git-ignored.
HOST_OS=linux                 # windows | linux | mac
FRONTEND=es-de
ROMS_DIR=~/ROMs
ESDE_DIR=~/ES-DE
VPX_EXE=                      # path to VPinballX executable
VPX_TABLES_DIR=               # folder holding .vpx tables
# Only if the host is a separate machine managed over SSH:
SSH_HOST=
SSH_USER=
